{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "poster_url": {
      "type": "string"
    },
    "poster_type": {
      "type": "string",
      "enum": [
        "pdf",
        "image"
      ]
    },
    "poster_is_a4": {
      "type": "boolean",
      "default": true
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "enumColors": [
        "gray",
        "green",
        "yellow"
      ]
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}